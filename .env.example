# Run python scripts/setup.py to generate secrets. Do not commit .env.
ENVIRONMENT=development
ENCRYPTION_KEYS=
# Production requires https, secure cookies, PostgreSQL, and Redis.
ALLOWED_ORIGINS=["http://localhost:7860"]
COOKIE_SECURE=false
ALLOW_REGISTRATION=true
REGISTRATION_CODE=
DATABASE_URL=sqlite+aiosqlite:///./gateway.db
# Redis optional only in development. Production requires it.
REDIS_URL=
MAX_RETRIES=2
REQUESTS_PER_MINUTE=60
UPSTREAM_TIMEOUT_SECONDS=60
MAX_REQUEST_BYTES=26214400
MAX_RESPONSE_BYTES=52428800
DISCOVERY_INTERVAL_SECONDS=3600
HEALTH_INTERVAL_SECONDS=60
CIRCUIT_COOLDOWN_SECONDS=30
HIGH_LATENCY_MS=15000
LOG_RETENTION_DAYS=30
# Exact hosts allowed to resolve to private IPs; operator-only for Ollama/LM Studio.
PRIVATE_UPSTREAM_HOSTS=[]
STATIC_DIR=frontend/out
PORT=7860

# Optional ONE-TIME promotion of an EXISTING account by deploy/start.py.
# Remove after activation. Does not create accounts or set passwords.
# ADMIN_BOOTSTRAP_EMAIL=owner@example.com
